{
  "name": "dsh-useful-tools",
  "version": "0.1.2",
  "description": "Component-based DSH utilities with multimodal conversation titles",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./session-titles": "./src/host/session-titles/component.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./session-titles/locale/en.json": "./src/host/session-titles/locale/en.json",
    "./session-titles/locale/zh.json": "./src/host/session-titles/locale/zh.json"
  },
  "files": [
    "index.js",
    "src/host/config.js",
    "src/host/routes.js",
    "src/host/title-control.js",
    "src/host/session-titles/component.js",
    "src/host/session-titles/engine.js",
    "src/host/session-titles/generator.js",
    "src/host/session-titles/input.js",
    "src/host/session-titles/locale/en.json",
    "src/host/session-titles/locale/zh.json",
    "locale/en.json",
    "locale/zh.json",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "=0.2.1-rc.2 || =0.2.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5 || 4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5 || 3.18.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2 || 0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.2.1-rc.2 || 0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT"
}
